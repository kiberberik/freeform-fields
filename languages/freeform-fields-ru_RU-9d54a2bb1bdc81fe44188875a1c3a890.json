44b, _ \u0438 -."],"Changing the name of a saved field hides values already stored under the old name.":["\u0415\u0441\u043b\u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u043c\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f, \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0434 \u0441\u0442\u0430\u0440\u044b\u043c \u0438\u043c\u0435\u043d\u0435\u043c \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u0443\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f."],"Field Type":["\u0422\u0438\u043f \u043f\u043e\u043b\u044f"],"Sub Fields":["\u041f\u043e\u0434\u043f\u043e\u043b\u044f"],"Instructions":["\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438"],"Shown to editors under the label.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430\u043c \u043f\u043e\u0434 \u043f\u043e\u0434\u043f\u0438\u0441\u044c\u044e."],"Required":["\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435"],"Width (%)":["\u0428\u0438\u0440\u0438\u043d\u0430 (%)"],"Wrapper CSS class":["CSS-\u043a\u043b\u0430\u0441\u0441 \u043e\u0431\u0451\u0440\u0442\u043a\u0438"],"Wrapper ID":["ID \u043e\u0431\u0451\u0440\u0442\u043a\u0438"],"Field key:":["\u041a\u043b\u044e\u0447 \u043f\u043e\u043b\u044f:"],"\u2014 None \u2014":["\u2014 \u041d\u0435\u0442 \u2014"],"Please fix the highlighted problems and save again.":["\u0418\u0441\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u0435 \u043e\u0448\u0438\u0431\u043a\u0438 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430."],"Edit Field Group":["\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u0443 \u043f\u043e\u043b\u0435\u0439"],"Unsaved changes":["\u0415\u0441\u0442\u044c \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u045