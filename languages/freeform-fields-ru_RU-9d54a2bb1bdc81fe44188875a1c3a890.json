\u0432\u0435\u0442\u044b REST API WordPress (\u0441\u0432\u043e\u0439\u0441\u0442\u0432\u043e \u00abacf\u00bb)."],"Inactive groups are not shown on edit screens.":["\u041d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0433\u0440\u0443\u043f\u043f\u044b \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0430\u0445 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f."],"Position":["\u041f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435"],"High (after title)":["\u0412\u044b\u0441\u043e\u043a\u043e (\u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0430)"],"Normal (after content)":["\u041e\u0431\u044b\u0447\u043d\u043e (\u043f\u043e\u0441\u043b\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0433\u043e)"],"Side":["\u0421\u0431\u043e\u043a\u0443"],"Style":["\u0421\u0442\u0438\u043b\u044c"],"Standard (meta box)":["\u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 (\u043c\u0435\u0442\u0430\u0431\u043e\u043a\u0441)"],"Seamless (no meta box)":["\u0411\u0435\u0441\u0448\u043e\u0432\u043d\u044b\u0439 (\u0431\u0435\u0437 \u043c\u0435\u0442\u0430\u0431\u043e\u043a\u0441\u0430)"],"Label Placement":["\u0420\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u0435\u0439"],"Instruction Placement":["\u0420\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0439"],"Below labels":["\u041f\u043e\u0434 \u043f\u043e\u0434\u043f\u0438\u0441\u044f\u043c\u0438"],"Below fields":["\u041f\u043e\u0434 \u043f\u043e\u043b\u044f\u043c\u0438"],"Order No.":["\u041f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440"],"Groups with a lower number appear first.":["\u0413\u0440\u0443\u043f\u043f\u044b \u0441 \u043c\u0435\u043d\u044c\u0448\u0438\u043c \u043d\u043e\u043c\u0435\u0440\u043e\u043c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0440\u0430\u043d\u044c\u0448\u0435."],"Description":["\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"],"Shown in the field group list.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439."],"An options page adds an admin menu item with fields for site-wide settings. Show a field group on it with the location rule \"Options Page\".":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u0443\u043d\u043a\u0442 \u043c\u0435\u043d\u044e \u0430\u0434\u043c\u0438\u043d\u043a\u0438 \u0441 \u043f\u043e\u043b\u044f\u043c\u0438 \u0434\u043b\u044f \u043e\u0431\u0449\u0438\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0441\u0430\u0439\u0442\u0430. \u041f\u043e\u043a\u0430\u0436\u0438\u0442\u0435 \u043d\u0430 \u043d\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u0443 \u043f\u043e\u043b\u0435\u0439 \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u043e\u043c \u00ab\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a\u00bb."],"Menu":["\u041c\u0435\u043d\u044e"],"Field groups":["\u0413\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439"],"Delete the options page \"%s\"? Saved values are kept.":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u00ab%s\u00bb? \u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f."],"Options page deleted.":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0443\u0434\u0430\u043b\u0435\u043d\u0430."],"Delete":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c"],"Edit Options Page":["\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a"],"Open page":["\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"Options page saved. Reload the admin to see menu changes.":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0430\u0434\u043c\u0438\u043d\u043a\u0443, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043c\u0435\u043d\u044e."],"Page Title":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b"],"Menu Title":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0432 \u043c\u0435\u043d\u044e"],"Defaults to the page title.":["\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u2014 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b."],"Menu Slug":["Slug \u043c\u0435\u043d\u044e"],"Used in the admin URL and in the \"Options Page\" location rule.":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0432 \u0430\u0434\u0440\u0435\u0441\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0438 \u0432 \u043f\u0440\u0430\u0432\u0438\u043b\u0435 \u00ab\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a\u00bb."],"Parent Menu":["\u0420\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0435 \u043c\u0435\u043d\u044e"],"Who can edit":["\u041a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c"],"Storage key (post_id)":["\u041a\u043b\u044e\u0447 \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f (post_id)"],"Values are read with get_field( name, this key ). Default: options.":["\u0417\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 get_field( \u0438\u043c\u044f, \u044d\u0442\u043e\u0442 \u043a\u043b\u044e\u0447 ). \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e: options."],"Menu Icon":["\u0418\u043a\u043e\u043d\u043a\u0430 \u043c\u0435\u043d\u044e"],"A dashicons class (dashicons-admin-generic) or an image URL.":["\u041a\u043b\u0430\u0441\u0441 dashicons (dashicons-admin-generic) \u0438\u043b\u0438 URL \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f."],"Menu Position":["\u041f\u043e\u0437\u0438\u0446\u0438\u044f \u0432 \u043c\u0435\u043d\u044e"],"Update Button Label":["\u0422\u0435\u043a\u0441\u0442 \u043a\u043d\u043e\u043f\u043a\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f"],"Default: Update":["\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e: \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c"],"Updated Message":["\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u043b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f"],"Default: Options Updated":["\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e: \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b"],"Open first sub page":["\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"When the page has sub pages, its menu item opens the first one.":["\u0415\u0441\u043b\u0438 \u0443 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0435\u0441\u0442\u044c \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b, \u043f\u0443\u043d\u043a\u0442 \u043c\u0435\u043d\u044e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0432\u0443\u044e \u0438\u0437 \u043d\u0438\u0445."],"Autoload values":["\u0410\u0432\u0442\u043e\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439"],"Load values with every request. Use for small settings needed on most pages.":["\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435. \u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a, \u043d\u0443\u0436\u043d\u044b\u0445 \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446."],"Choose field groups, then download them as JSON (to import elsewhere) or get PHP code to register them in a theme.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u0438 \u0441\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u0438\u0445 \u043a\u0430\u043a JSON (\u0434\u043b\u044f \u0438\u043c\u043f\u043e\u0440\u0442\u0430 \u0432 \u0434\u0440\u0443\u0433\u043e\u043c \u043c\u0435\u0441\u0442\u0435) \u0438\u043b\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 PHP-\u043a\u043e\u0434 \u0434\u043b\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432 \u0442\u0435\u043c\u0435."],"Select all":["\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0432\u0441\u0435"],"Export as JSON":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u0432 JSON"],"Generate PHP":["\u0421\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c PHP"],"PHP code":["PHP-\u043a\u043e\u0434"],"Paste into your theme's functions.php. Delete the database copies afterwards to avoid duplicates.":["\u0412\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0432 functions.php \u0442\u0435\u043c\u044b. \u0417\u0430\u0442\u0435\u043c \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043a\u043e\u043f\u0438\u0438 \u0438\u0437 \u0431\u0430\u0437\u044b, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0434\u0443\u0431\u043b\u0435\u0439."],"This file is not valid JSON.":["\u042d\u0442\u043e \u043d\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 JSON-\u0444\u0430\u0439\u043b."],"JSON file":["JSON-\u0444\u0430\u0439\u043b"],"These field groups were created with ACF. Importing keeps their keys, so values already saved by ACF keep working.":["\u042d\u0442\u0438 \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u0441\u043e\u0437\u0434\u0430\u043d\u044b \u0432 ACF. \u041f\u0440\u0438 \u0438\u043c\u043f\u043e\u0440\u0442\u0435 \u043a\u043b\u044e\u0447\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f, \u0443\u0436\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 ACF, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c."],"already imported":["\u0443\u0436\u0435 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430"],"Import from ACF":["\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0437 ACF"],"No field groups created with ACF were found in the database.":["\u0413\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0432 ACF, \u0432 \u0431\u0430\u0437\u0435 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b."],"Saved field groups are written to:":["\u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0432:"],"Local JSON is off. Create this folder (writable by the web server) to save field groups as JSON files:":["Local JSON \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d. \u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u044d\u0442\u0443 \u043f\u0430\u043f\u043a\u0443 (\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0443\u044e \u0432\u0435\u0431-\u0441\u0435\u0440\u0432\u0435\u0440\u0443 \u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u044c), \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u0432 JSON-\u0444\u0430\u0439\u043b\u044b:"],"Field groups are loaded from:":["\u0413\u0440\u0443\u043f\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f \u0438\u0437:"],"Export Field Groups":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439"],"Import Field Groups":["\u0418\u043c\u043f\u043e\u0440\u0442 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439"],"Migrate from ACF":["\u041f\u0435\u0440\u0435\u043d\u043e\u0441 \u0438\u0437 ACF"],"Local JSON":["Local JSON"],"Key":["\u041a\u043b\u044e\u0447"],"Terms":["\u0422\u0435\u0440\u043c\u0438\u043d\u044b"],"Delete the post type \"%s\"? Its posts stay in the database but are hidden until it is registered again.":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0438 \u00ab%s\u00bb? \u0415\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0438 \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f \u0432 \u0431\u0430\u0437\u0435, \u043d\u043e \u0431\u0443\u0434\u0443\u0442 \u0441\u043a\u0440\u044b\u0442\u044b, \u043f\u043e\u043a\u0430 \u0442\u0438\u043f \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0442 \u0441\u043d\u043e\u0432\u0430."],"Delete the taxonomy \"%s\"? Its terms stay in the database but are hidden until it is registered again.":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u044e \u00ab%s\u00bb? \u0415\u0451 \u0442\u0435\u0440\u043c\u0438\u043d\u044b \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f \u0432 \u0431\u0430\u0437\u0435, \u043d\u043e \u0431\u0443\u0434\u0443\u0442 \u0441\u043a\u0440\u044b\u0442\u044b, \u043f\u043e\u043a\u0430 \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u044e \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0442 \u0441\u043d\u043e\u0432\u0430."],"Deleted.":["\u0423\u0434\u0430\u043b\u0435\u043d\u043e."],"Edit Post Type":["\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0438"],"Add Post Type":["\u041d\u043e\u0432\u044b\u0439 \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0438"],"Edit Taxonomy":["\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u044e"],"Add Taxonomy":["\u041d\u043e\u0432\u0430\u044f \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u044f"],"Saved. Reload the admin to see it in the menu.":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0430\u0434\u043c\u0438\u043d\u043a\u0443, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u043c\u0435\u043d\u044e."],"Plural Label":["\u041f\u043e\u0434\u043f\u0438\u0441\u044c \u0432\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0447\u0438\u0441\u043b\u0435"],"e.g. Books":["\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u041a\u043d\u0438\u0433\u0438"],"Singular Label":["\u041f\u043e\u0434\u043f\u0438\u0441\u044c \u0432 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0447\u0438\u0441\u043b\u0435"],"e.g. Book":["\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u041a\u043d\u0438\u0433\u0430"],"Post Type Key":["\u041a\u043b\u044e\u0447 \u0442\u0438\u043f\u0430 \u0437\u0430\u043f\u0438\u0441\u0438"],"Taxonomy Key":["\u041a\u043b\u044e\u0447 \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u0438"],"Up to 20 characters: a\u2013z, 0\u20139, _ and -. Changing it hides existing posts.":["\u0414\u043e 20 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432: a\u2013z, 0\u20139, _ \u0438 -. \u041f\u043e\u0441\u043b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u0441\u043a\u0440\u043e\u044e\u0442\u0441\u044f."],"Up to 32 characters: a\u2013z, 0\u20139, _ and -.":["\u0414\u043e 32 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432: a\u2013z, 0\u20139, _ \u0438 -."],"URL Slug":["Slug \u0432 URL"],"Defaults to the key.":["\u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u2014 \u043a\u043b\u044e\u0447."],"A dashicons class, e.g. dashicons-book.":["\u041a\u043b\u0430\u0441\u0441 dashicons, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 dashicons-book."],"Public":["\u041f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0439"],"Visible on the site and in the admin.":["\u0412\u0438\u0434\u0435\u043d \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u0438 \u0432 \u0430\u0434\u043c\u0438\u043d\u043a\u0435."],"Hierarchical":["\u0418\u0435\u0440\u0430\u0440\u0445\u0438\u0447\u0435\u0441\u043a\u0438\u0439"],"Like pages (parents and children).":["\u041a\u0430\u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b (\u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0434\u043e\u0447\u0435\u0440\u043d\u0438\u0435)."],"Like categories (parents and children).":["\u041a\u0430\u043a \u0440\u0443\u0431\u0440\u0438\u043a\u0438 (\u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0434\u043e\u0447\u0435\u0440\u043d\u0438\u0435)."],"Needed for the block editor.":["\u041d\u0443\u0436\u043d\u043e \u0434\u043b\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0430 \u0431\u043b\u043e\u043a\u043e\u0432."],"Archive":["\u0410\u0440\u0445\u0438\u0432"],"A page listing all items.":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u043e \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u0432\u0441\u0435\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439."],"Exclude from Search":["\u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u0437 \u043f\u043e\u0438\u0441\u043a\u0430"],"Admin Column":["\u041a\u043e\u043b\u043e\u043d\u043a\u0430 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435"],"Show the terms in post lists.":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0442\u0435\u0440\u043c\u0438\u043d\u044b \u0432 \u0441\u043f\u0438\u0441\u043a\u0430\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439."],"Supports":["\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442"],"Import a JSON export from WP Freeform Fields or from ACF. Groups with the same key are updated.":["\u0418\u043c\u043f\u043e\u0440\u0442 JSON-\u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430 \u0438\u0437 WP Freeform Fields \u0438\u043b\u0438 \u0438\u0437 ACF. \u0413\u0440\u0443\u043f\u043f\u044b \u0441 \u0442\u0435\u043c \u0436\u0435 \u043a\u043b\u044e\u0447\u043e\u043c \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f."],"With WP-CLI: wp wpff sync, wp wpff export, wp wpff import <file>, wp wpff import-acf.":["\u0427\u0435\u0440\u0435\u0437 WP-CLI: wp wpff sync, wp wpff export, wp wpff import <file>, wp wpff import-acf."],"Allow in Block Bindings":["\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u0432 Block Bindings"],"Lets editors show this value in core blocks (paragraph, heading, image, button) on the site.":["\u041f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u0431\u043b\u043e\u043a\u0430\u0445 (\u0430\u0431\u0437\u0430\u0446, \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a, \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u043a\u043d\u043e\u043f\u043a\u0430)."],"Nothing found.":["\u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e."],"Theme check: %d PHP files use no ACF functions or hooks that WP Freeform Fields lacks.":["\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0442\u0435\u043c\u044b: \u0432 %d PHP-\u0444\u0430\u0439\u043b\u0430\u0445 \u043d\u0435\u0442 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0438 \u0445\u0443\u043a\u043e\u0432 ACF, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 WP Freeform Fields."],"Check your theme before deactivating ACF.":["\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0442\u0435\u043c\u0443, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0442\u044c ACF."],"These functions are not provided by WP Freeform Fields. Calling them without ACF causes a fatal error:":["\u042d\u0442\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043d\u0435\u0442 \u0432 WP Freeform Fields. \u0418\u0445 \u0432\u044b\u0437\u043e\u0432 \u0431\u0435\u0437 ACF \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043a \u0444\u0430\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u043e\u0448\u0438\u0431\u043a\u0435:"],"These ACF hooks are not fired by WP Freeform Fields, so the theme code attached to them will stop running:":["WP Freeform Fields \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u044d\u0442\u0438 \u0445\u0443\u043a\u0438 ACF, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0439 \u043a \u043d\u0438\u043c \u043a\u043e\u0434 \u0442\u0435\u043c\u044b \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c\u0441\u044f:"],"\u201c%s\u201d moved to the Trash.":["\u00ab%s\u00bb \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430 \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0443."],"Created \u201c%s\u201d.":["\u0421\u043e\u0437\u0434\u0430\u043d\u0430 \u00ab%s\u00bb."],"\u201c%s\u201d synced from its JSON file.":["\u00ab%s\u00bb \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u0438\u0437 JSON-\u0444\u0430\u0439\u043b\u0430."],"Sets of custom fields and the screens they appear on.":["\u041d\u0430\u0431\u043e\u0440\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043b\u0435\u0439 \u0438 \u044d\u043a\u0440\u0430\u043d\u044b, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043d\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f."],"Add field group":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u0443 \u043f\u043e\u043b\u0435\u0439"],"No field groups yet":["\u0413\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442"],"A field group is a set of fields \u2014 price, gallery, author bio \u2014 shown on the screens you choose.":["\u0413\u0440\u0443\u043f\u043f\u0430 \u043f\u043e\u043b\u0435\u0439 \u2014 \u044d\u0442\u043e \u043d\u0430\u0431\u043e\u0440 \u043f\u043e\u043b\u0435\u0439 (\u0446\u0435\u043d\u0430, \u0433\u0430\u043b\u0435\u0440\u0435\u044f, \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0430\u0432\u0442\u043e\u0440\u0430), \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0432\u0430\u043c\u0438 \u044d\u043a\u0440\u0430\u043d\u0430\u0445."],"Create your first field group":["\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u0443\u044e \u0433\u0440\u0443\u043f\u043f\u0443 \u043f\u043e\u043b\u0435\u0439"],"Filter field groups":["\u0424\u0438\u043b\u044c\u0442\u0440 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439"],"Search groups":["\u041f\u043e\u0438\u0441\u043a \u0433\u0440\u0443\u043f\u043f"],"Nothing found":["\u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e"],"Try another search or filter.":["\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u0437\u0430\u043f\u0440\u043e\u0441 \u0438\u043b\u0438 \u0444\u0438\u043b\u044c\u0442\u0440."],"Field group":["\u0413\u0440\u0443\u043f\u043f\u0430 \u043f\u043e\u043b\u0435\u0439"],"Shown on":["\u0413\u0434\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f"],"Actions":["\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f"],"PHP":["PHP"],"Loaded from a JSON file":["\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u0430 \u0438\u0437 JSON-\u0444\u0430\u0439\u043b\u0430"],"Actions for \u201c%s\u201d":["\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0434\u043b\u044f \u00ab%s\u00bb"],"Sync from JSON":["\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0437 JSON"],"Copy to an editable group":["\u0421\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0443\u0435\u043c\u0443\u044e \u0433\u0440\u0443\u043f\u043f\u0443"],"Move to Trash":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0443"],"Drag fields here, or pick a type in the \u201cAdd field\u201d panel.":["\u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0441\u044e\u0434\u0430 \u043f\u043e\u043b\u044f \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0438\u043f \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0438 \u00ab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u043b\u0435\u00bb."],"No fields yet. Drag a field type here from the \u201cAdd field\u201d panel, or click one to add it.":["\u041f\u043e\u043b\u0435\u0439 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442. \u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0441\u044e\u0434\u0430 \u0442\u0438\u043f \u043f\u043e\u043b\u044f \u0441 \u043f\u0430\u043d\u0435\u043b\u0438 \u00ab\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u043b\u0435\u00bb \u0438\u043b\u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043d\u0435\u0433\u043e."],"%1$s, %2$s field":["%1$s, \u043f\u043e\u043b\u0435 \u00ab%2$s\u00bb"],"Drag to move":["\u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c"],"Show sub fields":["\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u043e\u0434\u043f\u043e\u043b\u044f"],"Hide sub fields":["\u0421\u043a\u0440\u044b\u0442\u044c \u043f\u043e\u0434\u043f\u043e\u043b\u044f"],"Conditional":["\u0421 \u0443\u0441\u043b\u043e\u0432\u0438\u0435\u043c"],"More actions":["\u0414\u0440\u0443\u0433\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f"],"Move out of the parent field":["\u0412\u044b\u043d\u0435\u0441\u0442\u0438 \u0438\u0437 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u044f"],"Add a layout in the field settings to place fields in it.":["\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043c\u0430\u043a\u0435\u0442 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u043e\u043b\u044f, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u043c\u0435\u0449\u0430\u0442\u044c \u0432 \u043d\u0451\u043c \u043f\u043e\u043b\u044f."],"General":["\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0435"],"%s settings":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438: %s"],"Validation & presentation":["\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0438 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Conditional logic":["\u0423\u0441\u043b\u043e\u0432\u043d\u0430\u044f \u043b\u043e\u0433\u0438\u043a\u0430"],"Search field types":["\u041f\u043e\u0438\u0441\u043a \u0442\u0438\u043f\u043e\u0432 \u043f\u043e\u043b\u0435\u0439"],"Click to add after the selected field, or drag into place.":["\u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044f, \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0432 \u043d\u0443\u0436\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e."],"No field types found.":["\u0422\u0438\u043f\u044b \u043f\u043e\u043b\u0435\u0439 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b."],"Deleted \u201c%s\u201d.":["\u0423\u0434\u0430\u043b\u0435\u043d\u043e \u00ab%s\u00bb."],"New Field Group":["\u041d\u043e\u0432\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u043e\u043b\u0435\u0439"],"Save changes":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f"],"Create field group":["\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0433\u0440\u0443\u043f\u043f\u0443 \u043f\u043e\u043b\u0435\u0439"],"Field group title, e.g. Product details":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u0425\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0442\u043e\u0432\u0430\u0440\u0430\u00bb"],"Add field":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u043b\u0435"],"Select a field in the list to edit its settings.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u043e\u043b\u0435 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438."],"Presentation":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Group key:":["\u041a\u043b\u044e\u0447 \u0433\u0440\u0443\u043f\u043f\u044b:"],"Add options page":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a"],"No options pages yet":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043f\u043e\u043a\u0430 \u043d\u0435\u0442"],"Use one for things like a phone number, social links or a footer text that the whole site shares.":["\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043e\u0431\u0449\u0438\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0441\u0430\u0439\u0442\u0430: \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430, \u0441\u0441\u044b\u043b\u043e\u043a \u043d\u0430 \u0441\u043e\u0446\u0441\u0435\u0442\u0438, \u0442\u0435\u043a\u0441\u0442\u0430 \u0432 \u043f\u043e\u0434\u0432\u0430\u043b\u0435."],"New Options Page":["\u041d\u043e\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a"],"Export, import and move field groups between sites, or switch from ACF.":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442, \u0438\u043c\u043f\u043e\u0440\u0442 \u0438 \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0433\u0440\u0443\u043f\u043f \u043f\u043e\u043b\u0435\u0439 \u043c\u0435\u0436\u0434\u0443 \u0441\u0430\u0439\u0442\u0430\u043c\u0438, \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0441 ACF."],"Content types like Products or Events, each with its own admin menu.":["\u0422\u0438\u043f\u044b \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u0422\u043e\u0432\u0430\u0440\u044b\u00bb \u0438\u043b\u0438 \u00ab\u0421\u043e\u0431\u044b\u0442\u0438\u044f\u00bb, \u043a\u0430\u0436\u0434\u044b\u0439 \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u043f\u0443\u043d\u043a\u0442\u043e\u043c \u043c\u0435\u043d\u044e."],"Ways to group content, like Genres or Locations.":["\u0421\u043f\u043e\u0441\u043e\u0431\u044b \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u0416\u0430\u043d\u0440\u044b\u00bb \u0438\u043b\u0438 \u00ab\u0413\u043e\u0440\u043e\u0434\u0430\u00bb."],"Add post type":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0442\u0438\u043f \u0437\u0430\u043f\u0438\u0441\u0438"],"Add taxonomy":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0442\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u044e"],"No post types yet":["\u0422\u0438\u043f\u043e\u0432 \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442"],"No taxonomies yet":["\u0422\u0430\u043a\u0441\u043e\u043d\u043e\u043c\u0438\u0439 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442"],"Search options":["\u041f\u043e\u0438\u0441\u043a \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432"],"Read from ACF (read-only). Migrate it in Tools.":["\u0427\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0438\u0437 ACF (\u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u0435\u043d\u0438\u0435). \u041f\u0435\u0440\u0435\u043d\u0435\u0441\u0438\u0442\u0435 \u0435\u0451 \u0432 \u00ab\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0445\u00bb."],"This field group is read from ACF and cannot be edited here. Migrate it in Tools to edit it.":["\u042d\u0442\u0430 \u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u043e\u043b\u0435\u0439 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0438\u0437 ACF \u0438 \u043d\u0435 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0437\u0434\u0435\u0441\u044c. \u0427\u0442\u043e\u0431\u044b \u0435\u0451 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0438\u0442\u0435 \u0435\u0451 \u0432 \u00ab\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0445\u00bb."],"%d item imported.":["\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d %d \u044d\u043b\u0435\u043c\u0435\u043d\u0442.","\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043e %d \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430.","\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043e %d \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432."]}}}