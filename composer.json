{
	"name": "wpff/freeform-fields",
	"description": "Custom fields for WordPress with ACF-compatible storage.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "kiberberik",
			"homepage": "https://kiberberik.link",
			"role": "Author"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"setup": "bin/setup-dev.sh",
		"test": "phpunit",
		"lint": "phpcs"
	}
}
